# Every environment variable the API functions read (see api/_lib/config/env.js,
# the only module in the server that touches process.env).
#
# Copy these into Vercel -> Project -> Settings -> Environment Variables for BOTH
# Production and Preview. None of them belong in the browser: public/config.js
# holds only the site URL and the Supabase ANON key.
#
# Each value is on its own line with nothing after it, so a line can be copied
# into the Vercel form as-is. Comments sit on their own lines for that reason.
#
# REQUIRED means api/_lib/config/env.js has no fallback for it: without the variable the
# API throws "Missing environment variable <NAME>" and every request fails.
# OPTIONAL means the code already has a default, shown after the name.
#
# A missing or incorrect value is never reported as a 500. api/_lib/config/env.js raises a
# ConfigError, which the route wrapper answers as 503 {"error":"server_misconfigured"}, and
# the Vercel log line for that request names the variable - so a project that was copied
# without its settings says which line below to fix instead of looking like broken code.
# Redeploy after changing a variable: Vercel reads them at deploy time only.

# ---------------------------------------------------------------- site ------
# The deployed origin of this app, without a trailing slash. PayFast return and
# notify URLs are built from it, so it must be the public https address.
# Browser calls are also accepted from whatever address this deployment is actually
# reached on (the request's Origin has to match its own Host, which only a same-origin
# page can do), so a fresh *.vercel.app domain or a preview URL works without editing
# this - but buyers return from PayFast to SITE_URL, so it must be the real address.
# Any further origin belongs in ALLOWED_ORIGINS below.
# REQUIRED
SITE_URL=https://your-app.vercel.app

# ------------------------------------------------------------ supabase ------
# Project Settings -> API. The URL and the anon key also go in public/config.js.
# REQUIRED
SUPABASE_URL=https://your-project.supabase.co

# Project Settings -> API -> anon public. Safe in the browser: Row Level Security
# limits what it can do.
# REQUIRED
SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings -> API -> service_role. Server side only; it bypasses Row
# Level Security, so it must never appear in public/ or in any client bundle.
# REQUIRED
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------- payfast ------
# Settings -> Integration. Use the sandbox pair from
# https://sandbox.payfast.co.za while testing; the sandbox needs its own
# passphrase, and a buyer e-mail different from the merchant login e-mail.
# REQUIRED
PAYFAST_MERCHANT_ID=10000100

# Settings -> Integration.
# REQUIRED
PAYFAST_MERCHANT_KEY=your-merchant-key

# Settings -> Integration -> Passphrase. Subscriptions require one, and it must
# match the signature secret the API signs with.
# REQUIRED
PAYFAST_PASSPHRASE=a-long-random-string-of-your-own

# true = sandbox.payfast.co.za, false = www.payfast.co.za.
# OPTIONAL, default "true": a missing value cannot accidentally charge real cards.
PAYFAST_SANDBOX=true

# true = refuse ITN callbacks whose source IP is outside PayFast's published
# ranges. OPTIONAL, default "false". Turn it on only once DNS lookups work on
# your host, or callbacks will be rejected.
PAYFAST_ENFORCE_IP=false

# ---------------------------------------------------------- membership ------
# The monthly price in rand. It is sent to PayFast as "100.00". Keep it in step
# with PRICE_LABEL in public/config.js, which is only ever a label shown in the
# app and never charged.
# OPTIONAL, default "100"
SUBSCRIPTION_AMOUNT=100

# The line the member sees on the PayFast payment page.
# OPTIONAL, default "TSHK Compass monthly membership"
SUBSCRIPTION_ITEM_NAME=TSHK Compass monthly membership

# Free days granted when an account is created.
# OPTIONAL, default "7"
TRIAL_DAYS=7

# Extra days of access kept after a payment is late, before the paywall returns.
# OPTIONAL, default "3"
GRACE_DAYS=3

# ---------------------------------------------------- origin and limits ------
# Browser origins (besides SITE_URL and the deployment's own address) that may call
# this API. The app is served from the deployment, so the normal value is none. A
# comma-separated list of bare origins, for example https://staging.example.org
# OPTIONAL, default "none"
ALLOWED_ORIGINS=none

# Rate limiting: how many requests one caller may make to one route within the
# window below. Turn it off only for a load test.
# OPTIONAL, default "true"
RATE_LIMIT_ENABLED=true

# The window, in seconds, that RATE_LIMIT_MAX_REQUESTS and the per-route limits
# from api/_lib/config/policy.js are counted over.
# OPTIONAL, default "60"
RATE_LIMIT_WINDOW_SECONDS=60

# The fallback allowance for any route without an entry in RATE_LIMITS.
# OPTIONAL, default "60"
RATE_LIMIT_MAX_REQUESTS=60

# memory   = each serverless instance counts its own callers; no setup needed.
# supabase = one shared counter (rate_limits + consume_rate_limit in
#            supabase/schema.sql), so the limit holds across instances.
# OPTIONAL, default "memory"
RATE_LIMIT_BACKEND=memory

# true writes members' e-mail addresses into log lines; false writes a short
# hash instead, which is enough to follow one account through a log search.
# OPTIONAL, default "false"
LOG_EMAILS=false

# --------------------------------------------------------- revenuecat ------
# RevenueCat Dashboard -> Project -> Integrations -> Webhooks. Configure the
# webhook Authorization header to exactly this value. Keep it server-only.
# REQUIRED when RevenueCat store billing is enabled.
REVENUECAT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# RevenueCat entitlement identifier which unlocks the paid app (not a product
# identifier). Only events containing this entitlement can change store access.
# REQUIRED when RevenueCat store billing is enabled.
REVENUECAT_ENTITLEMENT_ID=premium
