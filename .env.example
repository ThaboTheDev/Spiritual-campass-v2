# Every environment variable the API functions read (see api/_lib/env.js).
#
# Copy these into Vercel -> Project -> Settings -> Environment Variables for BOTH
# Production and Preview. None of them belong in the browser: public/config.js
# holds only the site URL and the Supabase ANON key.
#
# Each value is on its own line with nothing after it, so a line can be copied
# into the Vercel form as-is. Comments sit on their own lines for that reason.
#
# REQUIRED means api/_lib/env.js has no fallback for it: without the variable the
# API throws "Missing environment variable <NAME>" and every request fails.
# OPTIONAL means the code already has a default, shown after the name.

# ---------------------------------------------------------------- site ------
# The deployed origin of this app, without a trailing slash. PayFast return and
# notify URLs are built from it, so it must be the public https address.
# REQUIRED
SITE_URL=https://your-app.vercel.app

# ------------------------------------------------------------ supabase ------
# Project Settings -> API. The URL and the anon key also go in public/config.js.
# REQUIRED
SUPABASE_URL=https://your-project.supabase.co

# Project Settings -> API -> anon public. Safe in the browser: Row Level Security
# limits what it can do.
# REQUIRED
SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings -> API -> service_role. Server side only; it bypasses Row
# Level Security, so it must never appear in public/ or in any client bundle.
# REQUIRED
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------- payfast ------
# Settings -> Integration. Use the sandbox pair from
# https://sandbox.payfast.co.za while testing; the sandbox needs its own
# passphrase, and a buyer e-mail different from the merchant login e-mail.
# REQUIRED
PAYFAST_MERCHANT_ID=10000100

# Settings -> Integration.
# REQUIRED
PAYFAST_MERCHANT_KEY=your-merchant-key

# Settings -> Integration -> Passphrase. Subscriptions require one, and it must
# match the signature secret the API signs with.
# REQUIRED
PAYFAST_PASSPHRASE=a-long-random-string-of-your-own

# true = sandbox.payfast.co.za, false = www.payfast.co.za.
# OPTIONAL, default "true": a missing value cannot accidentally charge real cards.
PAYFAST_SANDBOX=true

# true = refuse ITN callbacks whose source IP is outside PayFast's published
# ranges. OPTIONAL, default "false". Turn it on only once DNS lookups work on
# your host, or callbacks will be rejected.
PAYFAST_ENFORCE_IP=false

# ---------------------------------------------------------- membership ------
# The monthly price in rand. It is sent to PayFast as "100.00". Keep it in step
# with PRICE_LABEL in public/config.js, which is only ever a label shown in the
# app and never charged.
# OPTIONAL, default "100"
SUBSCRIPTION_AMOUNT=100

# The line the member sees on the PayFast payment page.
# OPTIONAL, default "TSHK Compass monthly membership"
SUBSCRIPTION_ITEM_NAME=TSHK Compass monthly membership

# Free days granted when an account is created.
# OPTIONAL, default "7"
TRIAL_DAYS=7

# Extra days of access kept after a payment is late, before the paywall returns.
# OPTIONAL, default "3"
GRACE_DAYS=3
